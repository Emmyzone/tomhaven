# Copy this file to ".env" and fill in the two values from your Supabase project
# (Supabase dashboard > Project Settings > API Keys).
# Only use the public key here (called "anon" or "publishable").
# NEVER put a "service_role" or "secret" key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
